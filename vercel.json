{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/downloads/FORMA-x-OUI-The-Dunes-Sound-Proposal.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"FORMA x OUI - The Dunes - Sound Proposal.pdf\""
        }
      ]
    },
    {
      "source": "/media/the-dunes-track-42s-pcm24.wav",
      "headers": [
        {
          "key": "Content-Type",
          "value": "audio/wav"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/thedunes-previews/audio/(.*).m4a",
      "headers": [
        {
          "key": "Content-Type",
          "value": "audio/mp4"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/thedunes-previews/film/the-dunes-pitch-film.mp4",
      "headers": [
        {
          "key": "Content-Type",
          "value": "video/mp4"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/moods",
      "destination": "/thedunes/moods",
      "permanent": false
    },
    {
      "source": "/moods/",
      "destination": "/thedunes/moods",
      "permanent": false
    },
    {
      "source": "/thedunes/previews",
      "destination": "/thedunes/moods",
      "permanent": false
    },
    {
      "source": "/thedunes/previews/",
      "destination": "/thedunes/moods",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/forma-landing"
    },
    {
      "source": "/floraoasis",
      "destination": "/city-of-arabia/coa-pitch-deck"
    },
    {
      "source": "/floraoasis/",
      "destination": "/city-of-arabia/coa-pitch-deck"
    },
    {
      "source": "/floraoasis/invoice",
      "destination": "/city-of-arabia/floraoasis-invoice"
    },
    {
      "source": "/floraoasis/invoice/",
      "destination": "/city-of-arabia/floraoasis-invoice"
    },
    {
      "source": "/admin",
      "destination": "/city-of-arabia/coa-admin"
    }
  ]
}
